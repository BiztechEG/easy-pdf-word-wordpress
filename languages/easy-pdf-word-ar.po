msgstr "تتاح الفاتورة عندما تكون حالة الطلب"

#: src/Admin/SettingsPage.php:332
msgid "Emails"
msgstr "رسائل البريد"

#: src/Admin/SettingsPage.php:332
msgid "The WooCommerce emails each document is attached to, as a PDF."
msgstr "رسائل WooCommerce التي يُرفق بها كل مستند بصيغة PDF."

#: src/Admin/SettingsPage.php:340
msgid "Sample invoice"
msgstr "فاتورة تجريبية"

#: src/Admin/SettingsPage.php:341
msgid ""
"Opens a sample invoice with the saved settings. Save your changes first."
msgstr "يفتح فاتورة تجريبية بالإعدادات المحفوظة. احفظ تغييراتك أولاً."

#: src/Admin/SettingsPage.php:342
msgid "Open the sample invoice (PDF)"
msgstr "افتح الفاتورة التجريبية (PDF)"

