msgstr "تُستبدل {year} بالسنة الحالية، مثل INV-{year}-."

#: src/Admin/SettingsPage.php:314
msgid "Credit note number prefix"
msgstr "بادئة رقم الإشعار الدائن"

#: src/Admin/SettingsPage.php:315
msgid "4 gives INV-0001."
msgstr "‏4 تعطي INV-0001."

#: src/Admin/SettingsPage.php:315
msgid "Digits in a number"
msgstr "عدد خانات الرقم"

#: src/Admin/SettingsPage.php:316
msgid "Next invoice number"
msgstr "رقم الفاتورة التالية"

#: src/Admin/SettingsPage.php:317
msgid "Next credit note number"
msgstr "رقم الإشعار الدائن التالي"

#: src/Admin/SettingsPage.php:327
msgid "Customers"
msgstr "العملاء"

#: src/Admin/SettingsPage.php:328
msgid "In My account"
msgstr "في حسابي"

#: src/Admin/SettingsPage.php:328
msgid "The documents customers can download for their own orders."
msgstr "المستندات التي يمكن للعملاء تنزيلها لطلباتهم."

#: src/Admin/SettingsPage.php:329
msgid ""
"Before then, customers cannot download the invoice and emails do not carry "
"it."
msgstr "قبل ذلك لا يمكن للعملاء تنزيل الفاتورة، ولا تُرفق برسائل البريد."

#: src/Admin/SettingsPage.php:329
